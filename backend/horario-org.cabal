cabal-version: 3.0
name:          horario-org
version:       0.1.0.0
build-type:    Simple
synopsis:      Nucleo de asignacion de horarios universitarios

library
  hs-source-dirs:   src
  exposed-modules:
    Domain.Tipos
    UseCases.Repositorio
    UseCases.Solver
  build-depends:
    base >= 4.20 && < 5,
    text >= 2.1 && < 3
  default-language: GHC2021
  ghc-options:      -Wall
