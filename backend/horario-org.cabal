cabal-version: 3.0
name:          horario-org
version:       0.1.0.0
build-type:    Simple
synopsis:      Nucleo de asignacion de horarios universitarios

library
  hs-source-dirs:   src
  exposed-modules:
    Domain.Tipos
    UseCases.Repositorio
    UseCases.Solver
    Domain.Disponibilidad
    Domain.Validador
    UseCases.Errores
    UseCases.Horarios
    UseCases.Generacion
    UseCases.Docentes
    Adapters.Prolog.JSON
    Adapters.Prolog.Proceso
  build-depends:
    aeson >= 2.2 && < 3,
    async >= 2.2 && < 2.3,
    base >= 4.20 && < 5,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.7 && < 0.8,
    process >= 1.6 && < 1.7,
    transformers >= 0.6 && < 0.7,
    text >= 2.1 && < 3
  default-language: GHC2021
  ghc-options:      -Wall
